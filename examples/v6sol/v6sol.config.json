{
  "baseDir": "/home/vishvananda/work",
  "workdir": "/home/vishvananda/work/v6sol",
  "useExistingWorkdir": true,
  "name": "v6sol",
  "assignmentLayout": "v5",
  "provider": "codex",
  "testCommand": "make test-report-through-paX",
  "checks": {
    "tests": {
      "command": "make test-report-through-{{testStage}}",
      "primary": true,
      "required": true,
      "kind": "test",
      "excludeStages": [
        "pa34",
        "pa35"
      ]
    },
    "priorThroughTests": {
      "command": "n={{stageNumber}}; if [ \"$n\" -le 1 ]; then echo '===== ALL TESTS PASSED SUCCESSFULLY! (0/0) ====='; else make test-report-through-pa$((n - 1)); fi",
      "required": true,
      "kind": "test",
      "excludeStages": [
        "pa34",
        "pa35"
      ]
    },
    "stageTests": {
      "command": "make test-{{testStage}}",
      "primary": true,
      "required": false,
      "kind": "test",
      "excludeStages": [
        "pa34",
        "pa35"
      ]
    },
    "stageProgress": {
      "command": "ralph:current-stage-progress stageTests {{testStage}}",
      "required": true,
      "dependsOn": [
        "priorThroughTests"
      ],
      "excludeStages": [
        "pa34",
        "pa35"
      ]
    },
    "stageProgressPreserved": {
      "command": "ralph:current-stage-progress stageTests {{testStage}} mode=preserve",
      "required": true,
      "dependsOn": [
        "priorThroughTests"
      ],
      "excludeStages": [
        "pa34",
        "pa35"
      ]
    },
    "fileAudit": {
      "command": "perl scripts/cppgm_file_audit.pl --stage {{testStage}} --paths dev",
      "required": true
    },
    "pa34HostThrough33": {
      "command": "make test-report-through-pa33",
      "required": true,
      "kind": "test",
      "targetStage": "pa34",
      "onlyStages": [
        "pa34"
      ]
    },
    "pa34SelfThroughPa5": {
      "command": "make -C pa34 test-through-pa5 CXX=../dev/cppgm++ CPPGM_HOST_CXX=g++",
      "required": true,
      "dependsOn": [
        "pa34HostThrough33"
      ],
      "kind": "generic",
      "targetStage": "pa34",
      "onlyStages": [
        "pa34"
      ]
    },
    "pa34PptokenInception": {
      "command": "make -C pa34 compare-pptoken-inception CXX=../dev/cppgm++ CPPGM_HOST_CXX=g++",
      "required": true,
      "dependsOn": [
        "pa34HostThrough33",
        "pa34SelfThroughPa5"
      ],
      "kind": "generic",
      "targetStage": "pa34",
      "onlyStages": [
        "pa34"
      ]
    },
    "pa34Inception": {
      "command": "make inception CXX=g++ CPPGM_HOST_CXX=g++",
      "primary": true,
      "required": true,
      "dependsOn": [
        "pa34HostThrough33",
        "pa34SelfThroughPa5",
        "pa34PptokenInception"
      ],
      "kind": "generic",
      "targetStage": "pa34",
      "onlyStages": [
        "pa34"
      ]
    },
    "pa35PriorThrough33": {
      "command": "make test-report-through-pa33",
      "kind": "test",
      "required": true,
      "targetStage": "pa33",
      "onlyStages": [
        "pa35"
      ]
    },
    "pa35Smoke": {
      "command": "make -C pa35 test-smoke",
      "kind": "generic",
      "required": true,
      "targetStage": "pa35",
      "onlyStages": [
        "pa35"
      ],
      "dependsOn": [
        "pa35PriorThrough33"
      ]
    },
    "pa35Progress": {
      "command": "make -C pa35 test-progress",
      "kind": "test",
      "primary": true,
      "required": false,
      "targetStage": "pa35",
      "onlyStages": [
        "pa35"
      ]
    },
    "pa35StageProgress": {
      "command": "ralph:current-stage-progress pa35Progress {{testStage}}",
      "required": true,
      "onlyStages": [
        "pa35"
      ],
      "dependsOn": [
        "pa35PriorThrough33",
        "pa35Smoke"
      ]
    },
    "pa35ProgressPreserved": {
      "command": "ralph:current-stage-progress pa35Progress {{testStage}} mode=preserve",
      "required": true,
      "onlyStages": [
        "pa35"
      ],
      "dependsOn": [
        "pa35PriorThrough33",
        "pa35Smoke"
      ]
    },
    "pa35Inception": {
      "command": "make inception CXX=g++ CPPGM_HOST_CXX=g++",
      "kind": "generic",
      "required": true,
      "targetStage": "pa35",
      "onlyStages": [
        "pa35"
      ],
      "dependsOn": [
        "pa35PriorThrough33"
      ]
    },
    "pa35Final": {
      "command": "make -C pa35 test",
      "kind": "test",
      "required": true,
      "primary": true,
      "targetStage": "pa35",
      "onlyStages": [
        "pa35"
      ],
      "dependsOn": [
        "pa35PriorThrough33",
        "pa35Inception"
      ]
    }
  },
  "phases": [
    {
      "name": "implement",
      "promptTemplate": "implement",
      "goalTemplate": "implement-goal",
      "promptTemplates": {
        "pa34": "pa34-implement",
        "pa35": "pa35-implement"
      },
      "goalTemplates": {
        "pa34": "pa34-implement-goal",
        "pa35": "pa35-implement-goal"
      },
      "checkpointOnRequiredChecks": true,
      "checkpointPhase": "checkpointAudit",
      "checkpointPhases": {
        "pa35": "restructure"
      },
      "checkpointPhaseEvery": 3,
      "checks": [
        "priorThroughTests",
        "stageTests",
        "fileAudit",
        "stageProgress",
        "pa34HostThrough33",
        "pa34SelfThroughPa5",
        "pa34PptokenInception",
        "pa34Inception",
        "pa35PriorThrough33",
        "pa35Smoke",
        "pa35Progress",
        "pa35StageProgress"
      ]
    },
    {
      "name": "checkpointAudit",
      "promptTemplate": "checkpointAudit",
      "goalTemplate": "checkpointAudit-goal",
      "checkpointOnly": true,
      "runWhenChecksPass": true,
      "returnPhaseOnIncompletePrimary": "implement",
      "checks": [
        "priorThroughTests",
        "stageTests",
        "fileAudit",
        "stageProgressPreserved",
        "pa35PriorThrough33",
        "pa35Smoke",
        "pa35Progress",
        "pa35ProgressPreserved"
      ],
      "promptTemplates": {
        "pa35": "pa35-checkpointAudit"
      },
      "goalTemplates": {
        "pa35": "pa35-checkpointAudit-goal"
      }
    },
    {
      "name": "restructure",
      "promptTemplate": "pa35-restructure",
      "goalTemplate": "pa35-restructure-goal",
      "checkpointOnly": true,
      "runWhenChecksPass": true,
      "returnPhaseOnIncompletePrimary": "implement",
      "checks": [
        "fileAudit",
        "pa35PriorThrough33",
        "pa35Smoke",
        "pa35Progress",
        "pa35ProgressPreserved",
        "pa35Inception"
      ]
    },
    {
      "name": "audit",
      "promptTemplate": "audit",
      "goalTemplate": "audit-goal",
      "promptTemplates": {
        "pa34": "pa34-audit",
        "pa35": "pa35-audit"
      },
      "goalTemplates": {
        "pa34": "pa34-audit-goal",
        "pa35": "pa35-audit-goal"
      },
      "runWhenChecksPass": true,
      "checks": [
        "fileAudit",
        "tests",
        "pa34HostThrough33",
        "pa34SelfThroughPa5",
        "pa34PptokenInception",
        "pa34Inception",
        "pa35PriorThrough33",
        "pa35Inception",
        "pa35Final"
      ]
    }
  ],
  "extraStages": [
    "pa34",
    "pa35"
  ],
  "maxTurns": 500,
  "stateBaseDir": "/home/vishvananda/work/.ralph",
  "model": "gpt-6.1-sol",
  "reasoningEffort": "high",
  "sandboxMode": "danger-full-access",
  "approvalPolicy": "never",
  "networkAccessEnabled": true,
  "webSearchEnabled": true,
  "sessionIsolation": {
    "enabled": true,
    "backend": "bwrap",
    "readOnlyRoot": true,
    "privateTmp": true,
    "privateWriteDir": "/home/vishvananda/work/private/v6sol",
    "privateWriteMaxBytes": 107374182400
  },
  "additionalDirectories": [],
  "outputTailChars": 20000,
  "loopGoalsEnabled": true,
  "goalTokenBudget": null,
  "freshThreadPerTurn": true,
  "eventLogScope": "run",
  "initialStage": "pa1",
  "resourceLimits": {
    "enabled": true,
    "backend": "systemd-run",
    "memoryMax": "64G",
    "memorySwapMax": "0",
    "oomGroup": false,
    "cleanupTimeoutSec": 2
  },
  "stopAfterStage": "pa35",
  "codexPath": "/usr/local/bin/codex"
}
